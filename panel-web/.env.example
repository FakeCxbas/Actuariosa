# ====================================================================
# VARIABLES DE ENTORNO — PANEL WEB ACTUARIOSA (SUPABASE + VERCEL)
# ====================================================================
# Copia este archivo como .env.local para pruebas locales.
# En Vercel: Ve a Project Settings -> Environment Variables y agrégalas.

# URL del proyecto en Supabase (ej: https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave pública anónima (anon public key)
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-de-supabase

# Clave secreta administrativa (service_role secret key) — SOLO para backend
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-de-supabase

# Token secreto para validar envíos desde MxCorreo
SYNC_API_KEY=actuariosa-telemetry-key-2026
